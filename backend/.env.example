# ============================================
# Cogent Environment Configuration
# ============================================

# Database
DATABASE_URL=postgresql://cogent_user:cogent_secret_2024@localhost:5432/cogent_db

# JWT Authentication
JWT_SECRET=cogent-jwt-secret-key-change-in-production-2024
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# LLM Providers (Gemini / Groq / OpenAI)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Web Search Provider (Layer 3 Live Web Acquisition)
TAVILY_API_KEY=

# Embedding Model
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# FAISS
FAISS_INDEX_PATH=/app/data/faiss/cogent.index
UPLOAD_DIR=/app/data/uploads
